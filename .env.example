# Application
ESTATEHUB_ENVIRONMENT=development
ESTATEHUB_DEBUG=true
ESTATEHUB_API_V1_PREFIX=/api/v1
ESTATEHUB_CORS_ORIGINS=["http://localhost:3001"]

# Authentication: access tokens (JWT, HMAC only)
# Generate each secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
# Secrets must be at least 32 characters and must differ from each other. Staging and
# production refuse to start when a secret is missing or still contains "change-me".
ESTATEHUB_JWT_ISSUER=estatehub-api
ESTATEHUB_JWT_AUDIENCE=estatehub-staff
ESTATEHUB_JWT_ALGORITHM=HS256
ESTATEHUB_JWT_SECRET_KEY=dev-only-change-me-jwt-secret-0123456789abcdef
ESTATEHUB_ACCESS_TOKEN_TTL_MINUTES=15

# Authentication: refresh sessions (opaque tokens, stored only as keyed hashes)
ESTATEHUB_REFRESH_TOKEN_HASH_SECRET=dev-only-change-me-refresh-hash-secret-fedcba987654
ESTATEHUB_REFRESH_SESSION_TTL_DAYS=7

# Authentication: cookies. AUTH_COOKIE_SECURE must be true in staging and production;
# false is only for local development over plain HTTP.
ESTATEHUB_AUTH_ACCESS_COOKIE_NAME=estatehub_access
ESTATEHUB_AUTH_REFRESH_COOKIE_NAME=estatehub_refresh
ESTATEHUB_AUTH_CSRF_COOKIE_NAME=estatehub_csrf
ESTATEHUB_AUTH_COOKIE_SECURE=false
ESTATEHUB_AUTH_COOKIE_SAME_SITE=lax
# Leave empty for a host-only cookie.
ESTATEHUB_AUTH_COOKIE_DOMAIN=
ESTATEHUB_AUTH_ACCESS_COOKIE_PATH=/
ESTATEHUB_AUTH_REFRESH_COOKIE_PATH=/api/v1/auth

# Authentication: rate limits (maximum attempts per window, windows in seconds)
ESTATEHUB_AUTH_LOGIN_MAX_ATTEMPTS_PER_IP=20
ESTATEHUB_AUTH_LOGIN_MAX_ATTEMPTS_PER_EMAIL=5
ESTATEHUB_AUTH_LOGIN_WINDOW_SECONDS=900
ESTATEHUB_AUTH_REFRESH_MAX_ATTEMPTS_PER_IP=60
ESTATEHUB_AUTH_REFRESH_WINDOW_SECONDS=60
ESTATEHUB_AUTH_PASSWORD_CHANGE_MAX_ATTEMPTS=5
ESTATEHUB_AUTH_PASSWORD_CHANGE_WINDOW_SECONDS=900
ESTATEHUB_AUTH_SESSION_MAX_REQUESTS_PER_IP=300
ESTATEHUB_AUTH_SESSION_WINDOW_SECONDS=60
ESTATEHUB_RATE_LIMIT_KEY_PREFIX=estatehub:rl

# Reverse proxies allowed to set X-Forwarded-For, as a JSON list of IPs or CIDRs.
# Leave empty unless the API runs behind a proxy you control, e.g. ["10.0.0.0/8"].
ESTATEHUB_TRUSTED_PROXIES=[]

# PostgreSQL
POSTGRES_DB=estatehub
POSTGRES_USER=estatehub
POSTGRES_PASSWORD=estatehub_dev_only
POSTGRES_HOST_PORT=5433
ESTATEHUB_DATABASE_URL=postgresql+asyncpg://estatehub:estatehub_dev_only@db:5432/estatehub

# Redis and Celery
ESTATEHUB_REDIS_URL=redis://redis:6379/0
ESTATEHUB_CELERY_BROKER_URL=redis://redis:6379/1
ESTATEHUB_CELERY_RESULT_BACKEND=redis://redis:6379/2

# Frontend
WEB_PORT=3001
# The browser always calls the API on the web origin at /api/v1; Next.js forwards those
# requests to this URL. Read when the dev server starts or the production image is built.
INTERNAL_API_BASE_URL=http://api:8000/api/v1
# Only needed if the API's cookie names were changed from their defaults.
# NEXT_PUBLIC_AUTH_ACCESS_COOKIE_NAME=estatehub_access
# NEXT_PUBLIC_AUTH_CSRF_COOKIE_NAME=estatehub_csrf
